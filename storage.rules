rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'XLC0hANEMpRewmMyxP0eTw8LGdl1'
        && userId == request.auth.uid
        && (request.resource == null
          || (request.resource.size < 210 * 1024 * 1024
            && (request.resource.contentType.matches('image/(jpeg|png|webp|avif)')
              || request.resource.contentType.matches('video/(mp4|webm)'))));
    }
  }
}
